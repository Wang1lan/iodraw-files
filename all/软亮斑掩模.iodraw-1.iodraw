        <mxCell id="FE1XEhHJz4enzpmOMskJ-155" value="&lt;b&gt;&lt;font color=&quot;#ff0808&quot; style=&quot;font-size: 16px;&quot;&gt;垂直膨胀&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="481" y="740" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-161" value="&lt;b&gt;&lt;font color=&quot;#ff0808&quot; style=&quot;font-size: 16px;&quot;&gt;阶段3：高斯滤波软化掩模&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#FF0808;fillColor=none;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1027" y="1160" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-194" value="&lt;b&gt;&lt;font color=&quot;#ff0808&quot; style=&quot;font-size: 16px;&quot;&gt;水平方向滤波&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1082" y="1210" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-221" value="&lt;b&gt;&lt;font color=&quot;#ff0808&quot; style=&quot;font-size: 16px;&quot;&gt;垂直方向滤波&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1091" y="1250" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-242" value="注：" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
          <mxGeometry x="750" y="350" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-243" value="由于膨胀采用全1的方形结构元，故二维结构元可以分解成两个一维矩阵，&lt;div&gt;两个一维结构元依次做膨胀，降低计算复杂度，同时利用或运算执行膨胀，&lt;/div&gt;&lt;div&gt;更加适合FPGA的运算逻辑。本例中膨胀结构元半径为2。故：&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="770.5" y="380" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-326" value="同样，高斯核天然具备可分离性，所以可以利用两个一维矩阵依次卷积，&lt;span style=&quot;background-color: initial;&quot;&gt;降低&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;运算复杂度。因为软化掩模不需要十分标准的高斯函数，所以这里采用了近似的&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;整数&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;高斯核，适配FPGA&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;的整数运算。一维矩阵的和为16，所以经过两次一维高&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;斯滤波，每个输出被放大了256倍，最后要右移八位进行复原。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="771" y="550" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-327" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="806" y="441" width="369" height="100" as="geometry" />
        </mxCell>
