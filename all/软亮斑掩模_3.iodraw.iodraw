        <mxCell id="tWRsVwRvUghYapvT9xmJ-336" value="&lt;font color=&quot;#ff0808&quot; style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;第二阶段：水平和垂直膨胀，膨胀半径为2&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="tWRsVwRvUghYapvT9xmJ-532">
