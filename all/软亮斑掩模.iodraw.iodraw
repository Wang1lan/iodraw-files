        <mxCell id="FE1XEhHJz4enzpmOMskJ-238" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="FE1XEhHJz4enzpmOMskJ-233" target="FE1XEhHJz4enzpmOMskJ-237" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-241" value="u12" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="FE1XEhHJz4enzpmOMskJ-238" vertex="1" connectable="0">
          <mxGeometry x="-0.1765" y="-1" relative="1" as="geometry">
            <mxPoint y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-233" value="&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;max&lt;/b&gt;&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="698.5" y="1486.5" width="35" height="35" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-236" value="逐像素做&lt;div&gt;max运算&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="681" y="1444" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-237" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;softMak&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="648" y="1564" width="136" height="50" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-242" value="注：" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
          <mxGeometry x="697" y="349" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-243" value="由于膨胀采用全1的方形结构元，故二维结构元可以分解成两个一维矩阵，&lt;div&gt;两个一维结构元依次做膨胀，降低计算复杂度，同时利用或运算执行膨胀，&lt;/div&gt;&lt;div&gt;更加适合FPGA的运算逻辑。本例中膨胀结构元半径为2。故：&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="717.5" y="379" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-326" value="同样，高斯核天然具备可分离性，所以可以利用两个一维矩阵依次卷积，&lt;span style=&quot;background-color: initial;&quot;&gt;降低&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;运算复杂度。因为软化掩模不需要十分标准的高斯函数，所以这里采用了近似的&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;整数&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;高斯核，适配FPGA&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;的整数运算。一维矩阵的和为16，所以经过两次一维高&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;斯滤波，每个输出被放大了256倍，最后要右移八位进行复原。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="718" y="549" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="FE1XEhHJz4enzpmOMskJ-327" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="753" y="440" width="369" height="100" as="geometry" />
        </mxCell>
